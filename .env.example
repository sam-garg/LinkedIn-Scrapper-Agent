# Root Pipeline - Environment Configuration
# Copy this file to '.env' in this root folder, or edit directly.

# -------------------------------------------------------
# Stage 2: AI Evaluation & Database Credentials
# -------------------------------------------------------
# Your Google Gemini API Key (Required for AI filtration)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Optional - for database storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# -------------------------------------------------------
# Stage 1: Scraper Browser Configuration
# -------------------------------------------------------
# Set to 'false' to see the browser window during URL discovery
SCRAPER_HEADLESS=false
DEFAULT_LIMIT=10

# Optional LinkedIn login credentials for auto-login
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_AUTO_LOGIN=false
