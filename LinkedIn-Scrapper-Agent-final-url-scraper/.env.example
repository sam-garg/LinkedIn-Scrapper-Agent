# LinkedIn Profile Scraper - Environment Configuration
# Copy this file to .env and edit values as needed.
#
# SECURITY RULES:
#   - Never commit .env to Git (it is in .gitignore).
#   - Never share .env with anyone.
#   - Never put real credentials in this .env.example file.

# -------------------------------------------------------
# Browser settings
# -------------------------------------------------------
# Set to 'false' to see the browser window (required for first login / debugging)
SCRAPER_HEADLESS=false

# -------------------------------------------------------
# Scraping defaults
# -------------------------------------------------------
DEFAULT_LIMIT=10

# -------------------------------------------------------
# Output paths
# -------------------------------------------------------
OUTPUT_DIR=data/output
LOG_DIR=data/logs

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

LINKEDIN_SAFE_MODE=true
MAX_PROFILES_PER_RUN=15
MAX_SEARCH_PAGES_PER_RUN=2
MAX_PROFILE_REQUESTS_PER_RUN=15
MIN_ACTION_DELAY=8
MAX_ACTION_DELAY=20
PROFILE_CACHE_DAYS=7

# -------------------------------------------------------
# Automatic login (optional)
# -------------------------------------------------------
# Supply your LinkedIn credentials here to enable automatic form-based login.
# The scraper will fill the normal LinkedIn login page exactly as a user would.
#
# IMPORTANT:
#   - Automatic login uses the NORMAL visible LinkedIn login form.
#   - No cookies are injected. No anti-bot techniques are used.
#   - If LinkedIn shows a CAPTCHA or checkpoint the scraper STOPS and
#     asks you to complete it manually in the browser.
#   - Leave these blank to always use manual login instead.
#   - NEVER commit real credentials to Git.

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Set to 'true' to attempt automatic login when a session is not active.
# Set to 'false' (or leave blank) to always prompt for manual login.
LINKEDIN_AUTO_LOGIN=false

# Seconds to wait for the login flow to complete before timing out.
LINKEDIN_LOGIN_TIMEOUT=120
