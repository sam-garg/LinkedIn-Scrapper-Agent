{
  "scraper": {
    "headless": false,
    "default_limit": 10,
    "page_timeout_ms": 30000,
    "navigation_timeout_ms": 60000,
    "delay_min_sec": 2.5,
    "delay_max_sec": 6.0,
    "search_page_max": 5,
    "scroll_steps": 3,
    "safe_mode": true,
    "max_profiles_per_run": 15,
    "max_search_pages_per_run": 2,
    "max_profile_requests_per_run": 15,
    "min_action_delay": 8,
    "max_action_delay": 20,
    "login_poll_interval_sec": 3,
    "login_poll_max_attempts": 30
  },
  "paths": {
    "browser_profile_dir": "data/browser_profile",
    "output_dir": "data/output",
    "log_dir": "data/logs",
    "universities_json": "config/universities.json",
    "output_csv": "data/output/linkedin_results.csv",
    "leads_csv": "data/output/linkedin_leads.csv",
    "leads_txt": "data/output/linkedin_urls.txt",
    "output_json": "data/output/linkedin_results.json"
  },
  "output": {
    "csv_columns": [
      "linkedin_url", "name", "headline", "location", "current_company", "current_title",
      "education", "university", "degree", "summary", "search_query", "scraped_at"
    ]
  },
